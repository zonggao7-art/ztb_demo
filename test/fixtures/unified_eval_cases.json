    {
      "id": "multi_two_companies",
      "category": "independent_multi_tool",
      "query": "分别查询甲方科技有限公司和乙方建设有限公司的处罚记录。",
      "expected_actions": [
        {"tool": "query_company_penalty", "args": {"company_name": "甲方科技有限公司"}},
        {"tool": "query_company_penalty", "args": {"company_name": "乙方建设有限公司"}}
      ],
      "expected_status": ["complete"]
    },
    {
      "id": "dependent_penalty",
      "category": "result_dependent",
      "query": "查询项目AH2024-001的中标记录，再查询中标供应商的处罚记录。",
      "expected_actions": [
        {"tool": "query_project_award", "args": {"project_number": "AH2024-001"}},
        {"tool": "query_company_penalty", "args": {"company_name": "甲方科技有限公司"}}
      ],
      "expected_status": ["complete"]
    },
    {
      "id": "dependent_company",
      "category": "result_dependent",
      "query": "查询项目AH2024-001的中标记录，再查询中标供应商的工商信息。",
      "expected_actions": [
        {"tool": "query_project_award", "args": {"project_number": "AH2024-001"}},
        {"tool": "query_company_registration", "args": {"company_name": "甲方科技有限公司"}}
      ],
      "expected_status": ["complete"]
