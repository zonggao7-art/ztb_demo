      "expected_actions": [{"tool": "query_project_award", "args": {"project_number": "AH2024-001"}}],
      "expected_status": ["complete"]
    },
    {
      "id": "single_company_award_history",
      "category": "single_tool",
      "query": "查询甲方科技有限公司的中标历史。",
      "expected_actions": [{"tool": "query_company_award_history", "args": {"company_name": "甲方科技有限公司"}}],
      "expected_status": ["complete"]
    },
    {
      "id": "multi_same_company",
      "category": "independent_multi_tool",
      "query": "查询甲方科技有限公司的工商信息和处罚记录。",
      "expected_actions": [
        {"tool": "query_company_registration", "args": {"company_name": "甲方科技有限公司"}},
        {"tool": "query_company_penalty", "args": {"company_name": "甲方科技有限公司"}}
      ],
      "expected_status": ["complete"]
