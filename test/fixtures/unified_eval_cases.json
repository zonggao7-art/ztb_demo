      "expected_actions": [],
      "expected_status": ["unsupported"]
    },
    {
      "id": "empty_penalty",
      "category": "empty_or_failure",
      "query": "查询空结果有限公司的处罚记录。",
      "expected_actions": [{"tool": "query_company_penalty", "args": {"company_name": "空结果有限公司"}}],
      "expected_status": ["complete"]
