{
  "schema_version": "unified-eval-v1",
  "variables": {
    "turns": "single",
    "temperature": 0,
    "tools": [
      "knowledge_qa",
      "query_company_registration",
      "query_company_business_scope",
      "query_company_penalty",
      "query_project_award",
      "query_company_award_history"
    ],
    "tool_backend": "fixed_fake"
  },
  "cases": [
    {
