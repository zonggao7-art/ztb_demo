    {
      "id": "failed_penalty",
      "category": "empty_or_failure",
      "query": "查询故障有限公司的处罚记录。",
      "expected_actions": [{"tool": "query_company_penalty", "args": {"company_name": "故障有限公司"}, "ok": false}],
      "expected_status": ["partial"]
