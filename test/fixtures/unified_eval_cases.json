    {
      "id": "single_company",
      "category": "single_tool",
      "query": "查询甲方科技有限公司的工商信息。",
      "expected_actions": [{"tool": "query_company_registration", "args": {"company_name": "甲方科技有限公司"}}],
      "expected_status": ["complete"]
    },
    {
      "id": "single_business_scope",
      "category": "single_tool",
      "query": "查询甲方科技有限公司的经营范围。",
      "expected_actions": [{"tool": "query_company_business_scope", "args": {"company_name": "甲方科技有限公司"}}],
      "expected_status": ["complete"]
    },
    {
      "id": "single_penalty",
      "category": "single_tool",
      "query": "查询甲方科技有限公司的处罚记录。",
      "expected_actions": [{"tool": "query_company_penalty", "args": {"company_name": "甲方科技有限公司"}}],
      "expected_status": ["complete"]
    },
    {
      "id": "single_bid",
      "category": "single_tool",
