# DeepSeek LLM（推理 + 路由）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

# Tavily（联网检索，可选）
TAVILY_API_KEY=

# MinerU（PDF 解析）
MINERU_API_TOKEN=

# SiliconFlow（BGE-m3 embedding + BGE reranker）
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=

# Embedding（若不走 SiliconFlow 则填其他服务）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# MySQL（业务数据库 ztb_clean）
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_CLEAN_DB=

# Milvus（向量库）
MILVUS_HOST=
MILVUS_PORT=
# 集合名（两端必须一致，保证可复现）
MILVUS_COLLECTION=public_kb
# BM25 混合检索（与集合 schema 绑定，两端一致）
ENABLE_MILVUS_BM25=true

# Embedding（若不走 SiliconFlow 则填其他服务）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT=60
EMBEDDING_MAX_RETRIES=3

# 分块参数为代码默认（2000/100），两端天然一致，不可经 .env 覆盖。

# PDF 三档路由（默认关闭=全量 MinerU；交接入库走 markdown/jsonl 不需要开）
PDF_TIERED_ROUTING_ENABLED=false
PDF_TIERED_TWO_COL_CONFIDENCE=0.80
PDF_TIERED_BACKGROUND_IMG_RATIO=0.70
PDF_TIERED_PROFILE_MAX_WORKERS=16
PDF_TIERED_BOOK_TIMEOUT_SEC=3600

# MinerU 远程解析服务（复杂页上云；本地交接入库用不到，导出/增量解析需要）
PDF_PARSE_BASE_URL=
MINERU_API_TOKEN=
MINERU_API_TIMEOUT=3600

# PDF 结构增强（表格原子块/目录过滤/双栏打标）
ENABLE_PDF_STRUCTURE=true