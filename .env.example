# ============================================================
# 模型身份配置（.env 单一事实源）
# 必填且唯一：缺失/空值时 Settings() 构造即抛错（无默认值、无别名兜底）。
# .env 换什么模型，项目实际调用什么模型；调用失败直接抛错。
# 见 design_docs/嵌入模型与混合检索整改工作计划_20260901.md §2.1
# ============================================================

# ── LLM 对话模型（唯一构造点 public_kb/llm_factory.py）──
LLM_API_KEY=                                   # 必填（如 OpenRouter: sk-or-v1-...）
LLM_BASE_URL=https://openrouter.ai/api/v1      # 必填（可填完整端点 /chat/completions，代码自动规范化）
LLM_MODEL=z-ai/glm-5.3-flash                   # 必填（.env 换什么模型，项目就调用什么模型）
#LLM_TIMEOUT=60                                # 可选：LLM 请求超时秒数
#LLM_MAX_RETRIES=1                             # 可选：LLM 请求最大重试次数

# ── Embedding（唯一构造点 public_kb/embedding_service.py）──
EMBEDDING_MODEL=                               # 必填（如 BAAI/bge-m3）
EMBEDDING_API_KEY=                             # 必填（如 SiliconFlow key）
EMBEDDING_BASE_URL=                            # 必填（如 https://api.siliconflow.cn/v1）
#EMBEDDING_DIM=1024                            # 可选：更换模型且维度不同时覆盖（默认 1024）
#EMBEDDING_TIMEOUT=30                          # 可选：Embedding 请求超时秒数
#EMBEDDING_MAX_RETRIES=1                       # 可选：Embedding 请求最大重试次数

# ── Reranker 精排模型（凭据/端点复用 EMBEDDING_*：同一服务提供方，有意设计）──
RERANKER_MODEL=                                # 必填（如 BAAI/bge-reranker-v2-m3）

# 历史备注（2026-09 整改后不再被读取，仅留档）：
# 旧别名兜底链 API_KEY/BASE_URL/MODEL_NAME、DEEPSEEK_API_KEY/DEEPSEEK_BASE_URL、
# SILICONFLOW_API_KEY/SILICONFLOW_BASE_URL、CLOSEAI_* 已全部移除，换服务只改上方规范名。

# MySQL（业务数据库 ztb_clean）
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_CLEAN_DB=
#SQL_QUERY_TIMEOUT=15                          # 可选：单条 SQL 客户端超时（秒）
#NODE_TOTAL_TIMEOUT=45                         # 可选：单次业务节点总超时（秒）

# Milvus（向量库）
MILVUS_HOST=
MILVUS_PORT=


# ============================================================
# 异步 + 记忆 + 流式改造增量（手册 §8.3）
# 说明:
#   - 所有 KEY= 默认留空或写示例值，禁止填写真实凭据
#   - 阶段 1~5 会逐步读取这些值；阶段 0 仅记录与归档
# ============================================================

# ========== Async / Concurrency ==========
ASYNC_BACKEND_ENABLED=false              # 总开关；阶段 0 保持 false，阶段 1 起逐步打开
ASYNC_IO_WORKERS=16
ASYNC_CPU_WORKERS=4
LLM_MAX_CONCURRENCY=8
EMBEDDING_MAX_CONCURRENCY=8
RERANK_MAX_CONCURRENCY=4
MILVUS_MAX_CONCURRENCY=8
#MILVUS_INSERT_BATCH=32                        # 可选：入库批量向量化的每批条数
PRICE_RECALL_CONCURRENCY=3

# ========== MySQL pool ==========
MYSQL_MAX_POOL_SIZE=16
MYSQL_ACQUIRE_TIMEOUT=3
SQL_STMT_TIMEOUT_S=8

# ========== Checkpointer ==========
CHECKPOINTER_BACKEND=memory              # memory | sqlite | postgres
CHECKPOINTER_SQLITE_PATH=checkpoints.db
# CHECKPOINTER_POSTGRES_DSN=postgresql://user:pass@host:5432/langgraph

# ========== Long-term Memory ==========
MEMORY_ENABLED=false
MEMORY_STORE_BACKEND=sqlite               # sqlite | postgres
MEMORY_SQLITE_PATH=memory.db
# MEMORY_PG_DSN=postgresql://user:pass@host:5432/memory
MEMORY_MAX_INJECTION_TOKENS=400
MEMORY_MIN_CONFIDENCE=0.7
MEMORY_ALLOW_EXTRACTED=false

# ========== Streaming ==========
STREAM_ENABLED=false
STREAM_HEARTBEAT_S=15
STREAM_CANCEL_GRACE_S=5

# ========== Reranker ==========
RERANK_TIMEOUT_S=5

# ============================================================
# 工具化（Tool Registry / Agent 平台化 P1）
# ============================================================
AGENT_TOOLS_ENABLED=false                # Agent 自助调用总开关（--agent-mode 需要 true）
AGENT_TOOLS_WHITELIST=                   # 逗号分隔工具名；空 = 全部可用
AGENT_TOOL_TIMEOUT_S=20                  # 单工具执行超时兜底（秒）
AGENT_TOOL_DEFAULT_TOP_K=20              # 检索类工具默认 top_k
AGENT_TOOL_MAX_CONTENT_CHARS=4000        # LLM 可见工具返回内容截断上限
AGENT_LOOP_MAX_STEPS=6                   # Agent 原型单次任务最大步数

# ========== 默认统一主 Agent（hybrid / legacy 保留为回滚入口） ==========
AGENT_EXECUTION_MODE=unified             # unified | hybrid | legacy；回滚只改此项
AGENT_REACT_ROLLOUT_PERCENT=100          # 仅 hybrid 下生效
AGENT_REACT_THREAD_ALLOWLIST=            # 逗号分隔；仅 hybrid 下生效
AGENT_REQUEST_TIMEOUT_S=90
AGENT_ROUTER_TIMEOUT_S=10
AGENT_REACT_TIMEOUT_S=65
AGENT_FINALIZE_RESERVE_S=15
AGENT_MAX_MODEL_CALLS=8                  # 含路由、纠错、嵌套RAG与回退；混合模式禁用SDK隐式重试
AGENT_MAX_TOOL_CALLS=6                   # 含拒绝/重试/缓存命中
AGENT_MAX_INPUT_BYTES=16000             # 外层调度请求的UTF-8字节上限，不等于token数
AGENT_RAG_MAX_INPUT_BYTES=48000         # 完整RAG作答独立额度；其余调用/超时预算仍共享
AGENT_MODEL_MAX_OUTPUT_TOKENS=4096
AGENT_AMOUNT_UNIT=                      # 数据管理员核定后填 元/万元；未核定不比较金额

# 飞书应用凭证（仅用于本地长连接；真实值只写入已忽略的 .env）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
