# MinerU 解析服务环境变量示例
# 复制为 .env 后填写真实值：cp .env.example .env

# 服务访问 token（本地 MinerUApiParser 调用时带在 Authorization: Bearer <token>）
MINERU_API_TOKEN=change-me-to-a-long-random-string

# 服务对外端口（容器内固定 8000，映射到宿主机该端口）
MINERU_PORT=8002

# GPU 卡号（多组共用时指定单卡，避免抢用；留空 = 全部可见）
# CUDA_VISIBLE_DEVICES=0

# magic-pdf 命令行（默认 magic-pdf）
MINERU_CMD=magic-pdf

# 设备模式：cuda / cpu
MINERU_DEVICE_MODE=cuda

# 单请求解析超时（秒），长文档可调大
MINERU_TIMEOUT=1800

# 显存限制（GB），8G 卡建议 6；服务器 32G 可留空
MINERU_DEVICE_MEMORY=

# 解析器版本（用于缓存 key 与 manifest；留空则运行时探测 magic-pdf 版本）
MINERU_PARSER_VERSION=
